                "${workspaceFolder}/4_UI_Console/UserInterface.cpp",
                "${workspaceFolder}/5_Main_Benchmask/Benchmark.cpp",
                "${workspaceFolder}/5_Main_Benchmask/main.cpp",
                "-o",
                "${fileDirname}/${fileBasenameNoExtension}"
